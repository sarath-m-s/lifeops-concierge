APP_ENV=production
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Swiggy MCP. There is NO client secret: OAuth 2.1 public client + PKCE (S256).
# SWIGGY_CLIENT_ID is not applied for — it is issued by Dynamic Client Registration
# (RFC 7591) at POST /auth/register. Leave blank on first boot, then copy the value
# the backend logs into this var so restarts reuse the registration.
# Staging (mcp-staging.swiggy.com) does not resolve; production is the only host.
SWIGGY_MCP_BASE=https://mcp.swiggy.com
SWIGGY_REDIRECT_URI=http://localhost:8000/auth/callback
SWIGGY_CLIENT_ID=

# Where /auth/callback bounces the user back into the app after a successful login.
MOBILE_SUCCESS_DEEPLINK=lifeops://

# Postgres backing the Swiggy token store (app/services/token_store.py). Required
# once the voice worker runs as a separate process from the web service — an
# in-memory token is invisible across processes. Optional for local single-process dev.
DATABASE_URL=

# LiveKit Cloud project (https://cloud.livekit.io) for the voice agent worker.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram (STT) and Cartesia (TTS) keys for the voice agent's speech pipeline.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# OpenAI key for the voice agent's LLM (function-calling brain).
OPENAI_API_KEY=
VOICE_LLM_MODEL=gpt-4o-mini

# Groq API key for the legacy /chat intent extraction (https://console.groq.com/keys).
# Without it the backend falls back to keyword matching — degraded, but the app
# still runs. Remove once agent.py/chat.py are deleted (see docs/superpowers plan).
LLM_API_KEY=
# Must handle tool calling reliably. gpt-oss-20b measured 12/12 clean turns;
# gpt-oss-120b and qwen3.8-27b both dropped turns on malformed tool envelopes.
LLM_MODEL=openai/gpt-oss-20b
