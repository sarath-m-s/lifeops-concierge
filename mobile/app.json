{
  "expo": {
    "name": "LifeOps Concierge",
    "slug": "lifeops-concierge",
    "scheme": "lifeops",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sarathms.lifeopsconcierge",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "LifeOps uses your microphone so you can talk to your concierge."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FC8019"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sarathms.lifeopsconcierge",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@livekit/react-native-expo-plugin",
        { "android": { "audioType": "communication" } }
      ],
      "@config-plugins/react-native-webrtc"
    ]
  }
}
